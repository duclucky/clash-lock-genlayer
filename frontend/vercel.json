{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/genlayer-rpc", "destination": "https://studio.genlayer.com/api" },
    { "source": "/((?!genlayer-rpc).*)", "destination": "/index.html" }
  ]
}
